<sdf version="1.7">
  <world name="icub_world">
  <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
   <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
   <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <!-- Gravity -->
    <gravity>0 0 -9.81</gravity>

    <!-- Simple ground plane -->
    <model name="custom_ground">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <box>
              <size>50 50 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <box>
              <size>50 50 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simple directional light -->
    <light name="sun_light" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.5 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- iCub humanoid (static, for 32 DOF reference) -->
    <include>
      <pose>0 0 5.0 0 0 0</pose>
      <uri>file:///mnt/c/Users/madhu/OneDrive/Desktop/vision_25/Gazebo/icub-models/iCub/robots/iCubGazeboV2_5/model.urdf</uri>
      <static>true</static>
    </include>

  <model name="simple_humanoid">
  <pose>2 0 0 0 0 0</pose>

  <!-- torso -->
  <link name="torso">
    <pose>0 0 1.0 0 0 0</pose>
    <visual name="torso_visual">
      <geometry>
        <box><size>0.3 0.2 0.6</size></box>
      </geometry>
    </visual>
  </link>

  <!-- head -->
  <link name="head">
    <visual name="head_visual">
      <geometry>
        <sphere><radius>0.15</radius></sphere>
      </geometry>
    </visual>
  </link>

  <!-- LEFT ARM UPPER -->
  <link name="l_upper_arm">
    <visual name="l_upper_arm_visual">
      <geometry>
        <cylinder>
          <radius>0.05</radius>
          <length>0.3</length>
        </cylinder>
      </geometry>
    </visual>
  </link>

  <!-- LEFT ARM LOWER -->
  <link name="l_lower_arm">
    <visual name="l_lower_arm_visual">
      <geometry>
        <cylinder>
          <radius>0.04</radius>
          <length>0.25</length>
        </cylinder>
      </geometry>
    </visual>
  </link>

  <!-- RIGHT ARM UPPER -->
  <link name="r_upper_arm">
    <visual name="r_upper_arm_visual">
      <geometry>
        <cylinder>
          <radius>0.05</radius>
          <length>0.3</length>
        </cylinder>
      </geometry>
    </visual>
  </link>

  <!-- RIGHT ARM LOWER -->
  <link name="r_lower_arm">
    <visual name="r_lower_arm_visual">
      <geometry>
        <cylinder>
          <radius>0.04</radius>
          <length>0.25</length>
        </cylinder>
      </geometry>
    </visual>
  </link>

  <!-- LEFT LEG UPPER -->
  <link name="l_upper_leg">
    <visual name="l_upper_leg_visual">
      <geometry>
        <cylinder>
          <radius>0.06</radius>
          <length>0.4</length>
        </cylinder>
      </geometry>
    </visual>
  </link>

  <!-- LEFT LEG LOWER -->
  <link name="l_lower_leg">
    <visual name="l_lower_leg_visual">
      <geometry>
        <cylinder>
          <radius>0.05</radius>
          <length>0.35</length>
        </cylinder>
      </geometry>
    </visual>
  </link>

  <!-- RIGHT LEG UPPER -->
  <link name="r_upper_leg">
    <visual name="r_upper_leg_visual">
      <geometry>
        <cylinder>
          <radius>0.06</radius>
          <length>0.4</length>
        </cylinder>
      </geometry>
    </visual>
  </link>

  <!-- RIGHT LEG LOWER -->
  <link name="r_lower_leg">
    <visual name="r_lower_leg_visual">
      <geometry>
        <cylinder>
          <radius>0.05</radius>
          <length>0.35</length>
        </cylinder>
      </geometry>
    </visual>
  </link>

  <!-- ======================== JOINTS ======================== -->

  <!-- head to torso -->
  <joint name="j_head" type="fixed">
    <parent>torso</parent>
    <child>head</child>
    <pose>0 0 0.45 0 0 0</pose>
  </joint>

  <!-- left shoulder -->
  <joint name="j_l_shoulder" type="revolute">
    <parent>torso</parent>
    <child>l_upper_arm</child>
    <pose>0 0.15 1.2 0 0 0</pose>
    <axis><xyz>0 0 1</xyz></axis>
  </joint>

  <!-- left elbow -->
  <joint name="j_l_elbow" type="revolute">
    <parent>l_upper_arm</parent>
    <child>l_lower_arm</child>
    <pose>0 0 0.15 0 0 0</pose>
    <axis><xyz>0 0 1</xyz></axis>
  </joint>

  <!-- right shoulder -->
  <joint name="j_r_shoulder" type="revolute">
    <parent>torso</parent>
    <child>r_upper_arm</child>
    <pose>0 -0.15 1.2 0 0 0</pose>
    <axis><xyz>0 0 1</xyz></axis>
  </joint>

  <!-- right elbow -->
  <joint name="j_r_elbow" type="revolute">
    <parent>r_upper_arm</parent>
    <child>r_lower_arm</child>
    <pose>0 0 0.15 0 0 0</pose>
    <axis><xyz>0 0 1</xyz></axis>
  </joint>

  <!-- left hip -->
  <joint name="j_l_hip" type="revolute">
    <parent>torso</parent>
    <child>l_upper_leg</child>
    <pose>0 0.1 0.7 0 0 0</pose>
    <axis><xyz>0 0 1</xyz></axis>
  </joint>

  <!-- left knee -->
  <joint name="j_l_knee" type="revolute">
    <parent>l_upper_leg</parent>
    <child>l_lower_leg</child>
    <pose>0 0 -0.2 0 0 0</pose>
    <axis><xyz>0 0 1</xyz></axis>
  </joint>

  <!-- right hip -->
  <joint name="j_r_hip" type="revolute">
    <parent>torso</parent>
    <child>r_upper_leg</child>
    <pose>0 -0.1 0.7 0 0 0</pose>
    <axis><xyz>0 0 1</xyz></axis>
  </joint>

  <!-- right knee -->
  <joint name="j_r_knee" type="revolute">
    <parent>r_upper_leg</parent>
    <child>r_lower_leg</child>
    <pose>0 0 -0.2 0 0 0</pose>
    <axis><xyz>0 0 1</xyz></axis>
  </joint>

</model>




  </world>
</sdf>
